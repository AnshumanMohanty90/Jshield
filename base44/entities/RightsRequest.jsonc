{
  "name": "RightsRequest",
  "type": "object",
  "properties": {
    "principal_name": {
      "type": "string",
      "title": "Data Principal Name"
    },
    "principal_email": {
      "type": "string",
      "title": "Principal Email"
    },
    "request_type": {
      "type": "string",
      "title": "Request Type",
      "enum": [
        "Access",
        "Correction",
        "Erasure",
        "Portability",
        "Grievance",
        "Nomination"
      ]
    },
    "description": {
      "type": "string",
      "title": "Request Details"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Received",
        "Under Review",
        "Fulfilled",
        "Rejected"
      ],
      "default": "Received"
    },
    "sla_deadline": {
      "type": "string",
      "format": "date-time",
      "title": "SLA Deadline"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To"
    },
    "response": {
      "type": "string",
      "title": "Response / Outcome"
    }
  },
  "required": [
    "principal_name",
    "request_type",
    "status"
  ]
}