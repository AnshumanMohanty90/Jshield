{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "work_email": {
      "type": "string",
      "title": "Work Email"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "designation": {
      "type": "string",
      "title": "Designation"
    },
    "company_size": {
      "type": "string",
      "title": "Company Size"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "intent": {
      "type": "string",
      "title": "Intent",
      "enum": [
        "assessment",
        "trial",
        "contact",
        "partner",
        "pricing"
      ],
      "default": "trial"
    },
    "source_page": {
      "type": "string",
      "title": "Source Page"
    },
    "readiness_score": {
      "type": "number",
      "title": "Readiness Score"
    },
    "readiness_band": {
      "type": "string",
      "title": "Readiness Band"
    },
    "readiness_gaps": {
      "type": "string",
      "title": "Top Gaps"
    },
    "assessment_answers": {
      "type": "string",
      "title": "Assessment Answers"
    },
    "submission_id": {
      "type": "string",
      "title": "Submission ID"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Contacted",
        "Trial Activated",
        "Rejected"
      ],
      "default": "New"
    }
  },
  "required": [
    "name",
    "work_email",
    "intent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}